# Configuración de producción. Se copia a .env en el servidor y se completa:
#   cp .env.produccion.example .env
#   docker compose -f docker-compose.produccion.yml run --rm app php artisan key:generate --show
# y se pega la clave en APP_KEY. Los valores con <...> son obligatorios.
# El .env nunca se sube al repositorio.

APP_NAME="Laboratorio de Simulación Clínica"
APP_ENV=production
APP_KEY=<clave de "key:generate --show">
# Nunca true en producción: mostraría trazas con rutas, consultas y datos.
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
# La dirección pública, con https. De ella salen los enlaces de los correos y
# la dirección de retorno que se registra en Google.
APP_URL=<https://laboratorio.dominio.edu.co>
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Puerto del servidor donde escucha el nginx del compose.
APP_PORT=80

# Si el HTTPS lo termina un proxy de la universidad, su IP (o varias,
# separadas por comas). Vacío si no hay proxy delante. Ver config/trustedproxy.php.
PROXIES_DE_CONFIANZA=

# Los registros van a la salida de los contenedores:
#   docker compose -f docker-compose.produccion.yml logs app
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laboratorio_simulacion
DB_USERNAME=laboratorio
DB_PASSWORD=<contraseña larga y aleatoria>

SESSION_DRIVER=database
SESSION_LIFETIME=120
# La cookie de sesión solo viaja por HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo institucional para las notificaciones (RF33).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<servidor SMTP>
MAIL_PORT=587
MAIL_USERNAME=<usuario SMTP>
MAIL_PASSWORD=<contraseña SMTP>
MAIL_FROM_ADDRESS=<laboratorio@dominio.edu.co>
MAIL_FROM_NAME="${APP_NAME}"

PERIODO_ACADEMICO_VIGENTE=

# Entrada con Google (RF18). Sin GOOGLE_CLIENT_ID la entrada no existe.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DOMINIO_INSTITUCIONAL=

# Content-Security-Policy. Solo se apaga si rompe alguna pantalla, mientras
# se corrige. Ver config/seguridad.php.
POLITICA_DE_CONTENIDO=true

# Copias de seguridad (servicio "copias"): carpeta del servidor donde se
# guardan, hora diaria y cuántos días se conservan. Tienen datos personales:
# la carpeta debe ser solo de root, y conviene copiarla fuera del servidor.
DIRECTORIO_COPIAS=/srv/laboratorio/copias
COPIAS_HORA=2
COPIAS_MINUTO=30
COPIAS_RETENCION_DIAS=14
