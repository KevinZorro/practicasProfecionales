# Configuración para correr SIN Docker (ADR 0010): PHP-FPM, nginx y el
# cliente de PostgreSQL del propio servidor, con la base en otra máquina.
# La guía está en docs/despliegue-nativo.md. Lo más fácil es:
#   ./nativo.sh configurar     (copia este archivo a .env y genera APP_KEY)
# y después completar a mano los valores con <...>.
# El .env nunca se sube al repositorio.

APP_NAME="Laboratorio de Simulación Clínica"
APP_ENV=production
APP_KEY=<lo genera "./nativo.sh configurar">
# Nunca true en un servidor: mostraría trazas con rutas, consultas y datos.
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
# La dirección con la que se entra. De ella salen los enlaces de los correos
# y la dirección de retorno que se registra en Google.
APP_URL=<http://direccion-del-servidor>
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Si el HTTPS lo termina un proxy de la universidad, su IP. Vacío si no hay.
PROXIES_DE_CONFIANZA=

# Sin Docker no hay salida de contenedor: los registros van a
# storage/logs/laravel-AAAA-MM-DD.log, uno por día, 14 días.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
# Escriben en ellos PHP-FPM (www-data) y el cron del usuario que despliega.
# 0664 si ese usuario está en el grupo www-data; 0666 si no (sandbox).
LOG_PERMISOS=0666

DB_CONNECTION=pgsql
# La máquina de PostgreSQL (la confirmó el ingeniero del servidor). 127.0.0.1
# solo si la base estuviera en este mismo servidor.
DB_HOST=172.18.222.232
DB_PORT=5432
DB_DATABASE=laboratorio
# El usuario con el que entra la aplicación.
DB_USERNAME=testlab
DB_PASSWORD=<contraseña>
# Opcional: el dueño de la base. Si se llena, las migraciones corren con él y
# la aplicación queda con un usuario que solo lee y escribe filas (S.1); el
# dueño necesita CREATEROLE. Vacío, todo corre con DB_USERNAME, que entonces
# tiene que ser dueño de las tablas (lo normal en un sandbox).
DB_DUENO_USUARIO=
DB_DUENO_CONTRASENA=

SESSION_DRIVER=database
SESSION_LIFETIME=60
# true solo si se entra por https: con http la cookie no viajaría y nadie
# podría iniciar sesión.
SESSION_SECURE_COOKIE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Todo en PostgreSQL: sin Redis, Memcached ni otro servicio aparte.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo. "log" deja los correos en el registro en vez de enviarlos: útil
# mientras no haya cuenta SMTP. Con cuenta, MAIL_MAILER=smtp y lo de abajo.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@laboratorio.invalid
MAIL_FROM_NAME="${APP_NAME}"

# Entrada con Google (RF18). Sin GOOGLE_CLIENT_ID la entrada no existe.
# Google exige https y un dominio en la dirección de retorno (no admite una IP).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DOMINIO_INSTITUCIONAL=

POLITICA_DE_CONTENIDO=true

# Copias de seguridad ("./nativo.sh copia", y a diario desde el cron): una
# carpeta del usuario que despliega, fuera de /var/www. Tienen datos
# personales. Vacío, no se hacen copias.
DIRECTORIO_COPIAS=
COPIAS_RETENCION_DIAS=14

POLITICA_DE_DATOS_URL=
